# ---- Database (Supabase Postgres). Local: `pnpm db:start` prints these.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy JWT secret (Project Settings → API → JWT secret). Used to mint room-scoped Realtime tokens for guests.
SUPABASE_JWT_SECRET=

# ---- App
PUBLIC_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ORGANIZER_PASSWORD=change-me
# Origins allowed to post feedback from the embedded widget (comma separated, * wildcard allowed)
WIDGET_ALLOWED_ORIGINS=http://localhost:5173

# ---- Demo defaults shown on the "create session" form
DEMO_GITHUB_REPOSITORY=johntestrun123-bot/crowdship-demo-cafe
DEMO_PRODUCTION_URL=

# ---- Coding agents: mock | devin | claude_code_action (default for new rooms)
CODING_AGENT_PROVIDER=mock
# Demo mode: a real, pre-built backup PR that the mock provider "discovers" (verified against real checks)
MOCK_PR_URL=
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai
# Claude Code Action provider dispatches this workflow in the demo repo
CLAUDE_CODE_WORKFLOW=crowdship-agent.yml

# ---- GitHub (fine-grained PAT scoped to the demo repo only)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---- Triage LLM (optional; deterministic fallback when unset)
TRIAGE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1-mini
