{
  "name": "crowdship",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "pnpm --filter @crowdship/web dev",
    "worker": "pnpm --filter @crowdship/worker start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "seed": "tsx scripts/seed.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "devDependencies": {
    "@crowdship/ai": "workspace:*",
    "@crowdship/db": "workspace:*",
    "@crowdship/integrations": "workspace:*",
    "@crowdship/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "^24.0.0",
    "postgres": "3.4.9",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}